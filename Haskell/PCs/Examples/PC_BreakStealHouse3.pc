PC PC_BreakStealHouse3 @ BreakStealHouse
   enum Stealable : 'TV','Money','Laptop','Other','Jewels'
   enum MeansBreakIn : 'window','stolenKey','door'
   after BreakStealHouse->getOutRun
   process BreakStealHouse  @ Q59536fcc
   after Q59536fcc->RefRansack6542b430
   quantifiedOp Q59536fcc.Choice x : 'MeansBreakIn'
   op_connector Q59536fcc->break
   atom :'break.x' 
   reference RefRansack6542b430
   ref_connector RefRansack6542b430->Ransack ('{TV, Money, Laptop}', '{}')
   atom :'getOutRun' 
   process Ransack (s, t) @ Op74d978e6
   operator Op74d978e6.Choice
   op_connector Op74d978e6->Q2baeb3ce
   op_connector Op74d978e6->breakSafe
   quantifiedOp Q2baeb3ce.Choice x : 'Stealable'
   op_connector Q2baeb3ce->steal
   after steal->RefRansack3c4c72de
   atom :'steal.x' {x = Other ⋁ x ∉ s }  
   reference RefRansack25c215b6
   ref_connector RefRansack25c215b6->Ransack ('s ∪ {Jewels}', 't')
   after breakSafe->RefRansack25c215b6
   atom :'breakSafe' {Jewels ∉ s}  
   reference RefRansack3c4c72de
   ref_connector RefRansack3c4c72de->Ransack ('s', 't ∪ {x}')
