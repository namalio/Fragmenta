PC PC_BreakStealHouse3 @ BreakStealHouse
   enum Stealable : 'TV','Money','Laptop','Other','Jewels'
   enum MeansBreakIn : 'window','stolenKey','door'
   after BreakStealHouse->getOutRun
   process BreakStealHouse  @ Q74ab91e6
   after Q74ab91e6->RefRansack47b7f154
   quantifiedOp Q74ab91e6.Choice x : 'MeansBreakIn'
   op_connector Q74ab91e6->break
   atom :'break.x' 
   reference RefRansack47b7f154
   ref_connector RefRansack47b7f154->Ransack ('{TV, Money, Laptop}', '{}')
   atom :'getOutRun' 
   process Ransack (s, t) @ Op25d4cf47
   operator Op25d4cf47.Choice
   op_connector Op25d4cf47->Q5d11a7f8
   op_connector Op25d4cf47->breakSafe
   op_connector Op25d4cf47->Skip4281b58d
   quantifiedOp Q5d11a7f8.Choice x : 'Stealable'
   op_connector Q5d11a7f8->steal
   after steal->RefRansack11d2b5c7
   atom :'steal.x' {x = Other ⋁ x ∉ t ⋀ x ∈ s}  
   reference RefRansack41592ea3
   ref_connector RefRansack41592ea3->Ransack ('s ∪ {Jewels}', 't')
   after breakSafe->RefRansack41592ea3
   atom :'breakSafe' {Jewels ∉ s}  
   reference RefRansack11d2b5c7
   ref_connector RefRansack11d2b5c7->Ransack ('s', 't ∪ {x}')
   skip Skip4281b58d
