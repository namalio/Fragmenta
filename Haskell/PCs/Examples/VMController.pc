PC PC_VendingMachineController {} @ Controller
import VMCommon as VMCI for PC_VendingMachineCommon
process Controller@SM
atom SM :'toO.start'
after SM->IS
atom IS: 'frI.itemSelected'
after IS->R
quantifiedOp R.IntChoice r : 'OkFail'
op_connector R->OpIf1
operator OpIf1.If
op_connector_g OpIf1->ProcessPayment{r = ok}
op_else_connector OpIf1->err
atom err :'toO.wrongItem'
process ProcessPayment@CA
atom CA :'toPay.chargeAmount'
atom PBP : 'toO.payment.doing'
after CA->PBP
after PBP->OpCarryPay
operator OpCarryPay.Choice
op_connector OpCarryPay->PC
op_connector OpCarryPay->PF
atom PC : 'frPay.pay.ok'
atom POk: 'toO.payment.done'
after PC->POk
after POk->R2
atom PF:'frPay.pay.fail'
atom IOPF:'toO.payment.error'
after PF->IOPF
quantifiedOp R2.Choice r : 'OkFail'
atom dOkFail:'toDisp.dispense.r'
op_connector R2->dOkFail
operator OpIf2.If
after dOkFail->OpIf2
op_connector_g OpIf2->OpCollect{r = ok}
op_else_connector OpIf2->Refu
atom IC :'frDisp.itemCollected'
atom Refu: 'toPay.refund'
atom ICT :'frDisp.itemCollectTimeout'
operator OpCollect.Choice
op_connector OpCollect->IC
op_connector OpCollect->ICT
reference RefController
ref_connector RefController->Controller
after Controller->RefController