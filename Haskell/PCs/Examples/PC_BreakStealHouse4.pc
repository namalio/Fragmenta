PC PC_BreakStealHouse4(alarmSounds) @ BreakStealHouse
   enum MeansBreakIn : 'stolenKey','window','door'
   enum Stealable : 'Laptop','Jewels','TV','Other'
   after BreakStealHouse->getOutAndRun
   process BreakStealHouse  @ Op2cc6eaf6
   atom :'getOutAndRun' 
   operator Op2cc6eaf6.Throw('alarmSounds')
   op_jump_connector Op2cc6eaf6->Skip4a55b6c9
   op_connector Op2cc6eaf6->DoBurglary
   atom :'alarmSounds' 
   process DoBurglary  @ Op3a1f99c2
   after Q59558b3f->RefSteal913c254
   quantifiedOp Q59558b3f.Choice x : 'MeansBreakIn'
   op_connector Q59558b3f->break
   atom :'break.x' 
   reference RefSteal913c254
   ref_connector RefSteal913c254->Steal('{Laptop, TV, Other}', '{}')
   process Steal (s, t) @ Op3767f4e1
   operator Op3767f4e1.Choice
   op_connector Op3767f4e1->Skip20f1913b
   op_connector Op3767f4e1->Q7af48227
   op_connector Op3767f4e1->breakSafe
   skip Skip20f1913b
   quantifiedOp Q7af48227.Choice x : 'Stealable'
   op_connector Q7af48227->steal
   after steal->RefSteal2a786799
   atom :'steal.x' {x = Other ⋁ x ∉ t ⋀ x ∈ s}  
   reference RefSteal2a786799
   ref_connector RefSteal2a786799->Steal('s', '{x} ∪ t')
   after breakSafe->RefSteal74432d4b
   atom :'breakSafe' {Jewels ∉ s}  
   reference RefSteal74432d4b
   ref_connector RefSteal74432d4b->Steal('s ∪ {Jewels}', 't')
   operator Op3a1f99c2.Interleave
   op_connector Op3a1f99c2->Q59558b3f
   op_connector Op3a1f99c2->alarmSounds
   skip Skip4a55b6c9
