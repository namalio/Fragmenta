digraph {

StartN_ [shape = cds,color=burlywood2,style=filled,height=.2,width=.2, label =PC_Panda];

Panda [shape=box,fillcolor=deepskyblue,style = filled,label="Panda"];
shoots [shape=ellipse,fillcolor="#B1FF8A",style=filled,label="shoots"];
leaves [shape=ellipse,fillcolor="#B1FF8A",style=filled,label="leaves"];
eats [shape=ellipse,fillcolor="#B1FF8A",style=filled,label="eats"];

{rank=same;leaves,shoots}
{rank=same;leaves,shoots,eats}
{rank=same;Panda,StartN_}

shoots->leaves[arrowtail=dot,dir=both,label="after"];
eats->shoots[arrowtail=dot,dir=both,label="after"];
Panda->eats[arrowhead="onormal",penwidth=2,label="="];
StartN_->Panda[label="starts"];
}