digraph {

StartN_ [shape = cds,color=burlywood2,style=filled,height=.2,width=.2, label =PC_VendingMachineCardPayments];

VMCI [shape=hexagon,fillcolor=orangered,style="filled,rounded",label =PC_VendingMachineCommon];
OpCardPayments [shape=diamond,fillcolor=yellow,style=filled,label="◻︎"];
CPO [shape=hexagon,fillcolor=gold1,style=filled,label=<◻︎ cpcs:CPCmds>];
cpo [shape=ellipse,fillcolor=greenyellow,style=filled,label="toPay.cpcs"];
RefCardPayments [shape=rectangle,fillcolor=gray,style="rounded,filled,dashed",label=""];
cpi [shape=ellipse,fillcolor=greenyellow,style=filled,label="frPay.cpms"];
CPI [shape=hexagon,fillcolor=gold1,style=filled,label=<⊓ cpms:CPMsgs>];
CardPayments [shape=box,fillcolor=deepskyblue,style = filled,label="CardPayments"];

{rank=same;RefCardPayments,CardPayments}
{rank=same;CardPayments,StartN_}

CardPayments->RefCardPayments[arrowtail=dot,dir=both,label="after"];
CPO->cpo[arrowhead="open"];
OpCardPayments->CPO[arrowhead="open"];
OpCardPayments->CPI[arrowhead="open"];
CPI->cpi[arrowhead="open"];
RefCardPayments->CardPayments[arrowhead="normalnormal",fillcolor=white,label=" "];
CardPayments->OpCardPayments[arrowhead="onormal",penwidth=2,label="="];
StartN_->CardPayments[label="starts"];
}