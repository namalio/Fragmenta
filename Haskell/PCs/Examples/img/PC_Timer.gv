digraph {

StartN_ [shape = cds,color=burlywood2,style=filled,height=.2,width=.2, label =PC_Timer];

Timer [shape=box,fillcolor=deepskyblue,style = filled,label="Timer (t)"];
Op49419096 [shape=diamond,fillcolor=yellow,style=filled,label="◻︎"];
timeout [shape=ellipse,fillcolor="#B1FF8A",style=filled,label=" {t = 0}
timeout"];
RefTimer60fa176d [shape=rectangle,fillcolor=gray,style="rounded,filled,dashed",label=""];
Stop202ab08b [shape=box,fillcolor=mistyrose2,style = filled,label="STOP"];
tock [shape=ellipse,fillcolor="#B1FF8A",style=filled,label=" {t > 0}
tock"];
OpIf3378007b [shape=diamond,fillcolor=yellow,style=filled,label="If"];

{rank=same;RefTimer60fa176d,tock}
{rank=same;Timer,StartN_}

RefTimer60fa176d->Timer[arrowhead="normalnormal",fillcolor=white,label=" (t-1)"];
Op49419096->timeout[arrowhead="open"];
OpIf3378007b->Stop202ab08b[arrowhead="open",label="Else"];
OpIf3378007b->Op49419096[arrowhead="open",label="t≥0"];
Op49419096->tock[arrowhead="open"];
tock->RefTimer60fa176d[arrowtail=dot,dir=both,label="after"];
Timer->OpIf3378007b[arrowhead="onormal",penwidth=2,label="="];
StartN_->Timer[label="starts"];
}