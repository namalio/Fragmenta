digraph {

StartN_ [shape = cds,color=burlywood2,style=filled,height=.2,width=.2, label =PC_Clock2];

Clock [shape=box,fillcolor=deepskyblue,style = filled,label="Clock"];
Ref517a796c [shape=rectangle,fillcolor=gray,style="rounded,filled,dashed",label=""];
tick [shape=ellipse,fillcolor=greenyellow,style=filled,label="tick"];

{rank=same;Ref517a796c,tick}
{rank=same;Clock,StartN_}

Ref517a796c->Clock[arrowhead="normalnormal",fillcolor=white,label=" "];
tick->Ref517a796c[arrowtail=dot,dir=both,label="after"];
Clock->tick[arrowhead="onormal",penwidth=2,label="="];
StartN_->Clock[label="starts"];
}