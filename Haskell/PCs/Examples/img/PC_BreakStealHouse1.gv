digraph {
subgraph cluster_MeansBreakIn {
style="filled,rounded";
label =MeansBreakIn;
fillcolor = cadetblue1;
window[shape=box,fillcolor=darkolivegreen1,style="filled",label="window"];
key[shape=box,fillcolor=darkolivegreen1,style="filled",label="key"];
openDoor[shape=box,fillcolor=darkolivegreen1,style="filled",label="openDoor"];
}


window->StartN_[style=invis]
StartN_ [shape = cds,color=burlywood2,style=filled,height=.2,width=.2, label =PC_BreakStealHouse1];

BreakStealHouse [shape=box,fillcolor=deepskyblue,style = filled,label="BreakStealHouse"];
stealTV [shape=ellipse,fillcolor=greenyellow,style=filled,label="stealTV"];
break [shape=ellipse,fillcolor=greenyellow,style=filled,label="break.x"];
Qabc1e05 [shape=hexagon,fillcolor=gold1,style=filled,label=<⊓ x:MeansBreakIn>];

{rank=same;stealTV,Qabc1e05}
{rank=same;BreakStealHouse,StartN_}

Qabc1e05->break[arrowhead="open"];
Qabc1e05->stealTV[arrowtail=dot,dir=both,label="after"];
BreakStealHouse->Qabc1e05[arrowhead="onormal",penwidth=2,label="="];
StartN_->BreakStealHouse[label="starts"];
}