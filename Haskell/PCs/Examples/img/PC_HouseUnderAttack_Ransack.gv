InLivingRoom->OpInLivingRoom[arrowhead="onormal",penwidth=2,label="="];
IntoHall->intoHall[arrowhead="onormal",penwidth=2,label="="];
Ransack->OpInHouse[arrowhead="onormal",penwidth=2,label="="];
