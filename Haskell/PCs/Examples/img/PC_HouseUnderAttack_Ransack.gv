digraph {

StartN_ [shape = cds,color=burlywood2,style=filled,height=.2,width=.2, label =PC_HouseUnderAttack_Ransack];

StartN__bs[shape=rect,fillcolor=yellow,style="filled,dotted",label="grabLaptop,grabJewels"];
