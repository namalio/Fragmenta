Protected [shape=hexagon,fillcolor=gold1,style=filled,label=<◻︎ x:pes>];
protected [shape=ellipse,fillcolor=greenyellow,style=filled,label="x"];
RefBarredAsset2 [shape=rectangle,fillcolor=gray,style="rounded,filled,dashed",label=""];
RefDoBarred [shape=rectangle,fillcolor=gray,style="rounded,filled,dashed",label=""];
doOther2 [shape=ellipse,fillcolor=greenyellow,style=filled,label="x"];
