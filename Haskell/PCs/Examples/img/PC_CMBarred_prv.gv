OpDoBarred2 [shape=diamond,fillcolor=yellow,style=filled,label="◻︎"];
DoBarred [shape=box,fillcolor=deepskyblue,style = filled,label="DoBarred"];
Erect [shape=hexagon,fillcolor=gold1,style=filled,label=<◻︎ x:bes>];
doOther [shape=ellipse,fillcolor=greenyellow,style=filled,label="x"];
SKIP [shape=box,fillcolor="#B9E0A5",style = filled,label="SKIP"];
CarryOut [shape=box,fillcolor=deepskyblue,style = filled,label="CarryOut"];
restart [shape=ellipse,fillcolor=greenyellow,style=filled,label="x"];
start [shape=ellipse,fillcolor=greenyellow,style=filled,label="x"];
OpBarredAsset [shape=diamond,fillcolor=yellow,style=filled,label="◻︎"];
CMBarred [shape=box,fillcolor=deepskyblue,style = filled,label="CMBarred"];

{rank=min;CMBarred,StartN_,StartN__ps,RefBarredAsset}
{rank=same;OpBarredAsset,Start,start,CarryOut,OpCarryOut}
{rank=same;Restart,restart}
{rank=same;RefCarryOut,OpCarryOut2}
{rank=same;DoBarred,OpDoBarred,OpDoBarred2,Other2}
{rank=same;RefBarredAsset2,BarredAsset}
