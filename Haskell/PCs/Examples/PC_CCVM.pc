PC PC_CCVM @ CCVM
   process CCVM  @ RefdoCCVM260224c7
   after RefdoCCVM260224c7->CCVM
   reference RefdoCCVM260224c7
   ref_connector RefdoCCVM260224c7->doCCVM ('0')
   process doCCVM (x) @ Op4cf8cb78
   process Receive  @ Op64173135
   process Dispense  @ dispense
   operator Op4cf8cb78.Choice
   op_connector Op4cf8cb78->Receive
   op_connector Op4cf8cb78->Dispense
   op_connector Op4cf8cb78->return
   operator Op64173135.Choice
   op_connector Op64173135->coin50p
   op_connector Op64173135->coinPound
   after coin50p->RefdoCCVM6c748c4e
   atom :'coin50p' {x≤100}  
   after coinPound->RefdoCCVM6334ae13
   atom :'coinPound' {x≤50}  
   atom :'return' {x ≥ 0}  
   reference RefdoCCVM6c748c4e
   ref_connector RefdoCCVM6c748c4e->doCCVM ('x+50')
   reference RefdoCCVM6334ae13
   ref_connector RefdoCCVM6334ae13->doCCVM ('x+100')
   after dispense->Op7935d8bf
   atom :'dispense' 
   operator Op7935d8bf.IntChoice
   op_connector Op7935d8bf->latte
   op_connector Op7935d8bf->macchiato
   op_connector Op7935d8bf->espresso
   op_connector Op7935d8bf->cappuccino
   atom :'latte' {x = 150}  
   atom :'macchiato' {x = 100}  
   atom :'espresso' {x = 100}  
   atom :'cappuccino' {x = 150}  