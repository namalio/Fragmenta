PC PC_OrderGoods {} @OrderGoods
atom :'receiveOrder'
process OrderGoods@receiveOrder
operator OpAfterReceiveOrder.Choice
after receiveOrder->OpAfterReceiveOrder
atom :'orderAccepted'
atom :'orderRejected'
op_connector OpAfterReceiveOrder->orderAccepted
op_connector OpAfterReceiveOrder->orderRejected
operator OpDoOrder.Interleave
process DoOrder@OpDoOrder
after orderAccepted->DoOrder
atom :'fillOrder'
atom :'sendInvoice'
op_connector OpDoOrder->fillOrder
op_connector OpDoOrder->sendInvoice
operator OpDelivery.IntChoice
process Delivery@OpDelivery
atom :'express'
atom :'regular'
after fillOrder->Delivery
op_connector OpDelivery->express
op_connector OpDelivery->regular
atom :'receivePayment'
after sendInvoice->receivePayment
atom :'closeOrder'
process CloseOrder@closeOrder
after DoOrder->CloseOrder
after orderRejected->CloseOrder
