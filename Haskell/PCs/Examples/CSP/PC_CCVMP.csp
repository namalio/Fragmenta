CCVM = doCCVM(0); CCVM

doCCVM(x) = 
   let 
      Receive = x <= 50 & coinPound -> doCCVM(x + 100)
            [] x <= 100 & coin50p -> doCCVM(x + 50)
      Dispense = dispense -> (x == 100 & espresso -> SKIP
            |~| (x == 150 & latte -> SKIP
            |~| (x == 100 & macchiato -> SKIP
            |~| x == 150 & cappuccino -> SKIP)))
   within
      x >= 0 & return -> SKIP
         [] Receive
         [] Dispense