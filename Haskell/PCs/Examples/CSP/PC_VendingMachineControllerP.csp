Controller = 
   let 
      Controller0 = toO.start -> frI.itemSelect -> (|~| r : OkFail @ if r == ok
         then
            toO.payConfirm -> ProcessPayment
         else
            toO.wrongItem -> SKIP)
      ProcessPayment = frI.cancel -> SKIP
            [] frI.itemConfirm -> toPay.charge -> toO.payI.doing -> (frPay.pay.ok -> toO.payI.done -> ([] r : OkFail @ toDisp.dispense.r -> if r == ok
         then
            frDisp.itemCollect -> SKIP
            [] frDisp.collectTimeout -> SKIP
         else
            toPay.refund -> toO.dispenseFail -> SKIP)
            [] frPay.pay.fail -> toO.payI.error -> SKIP)
   within
      Controller0; Controller