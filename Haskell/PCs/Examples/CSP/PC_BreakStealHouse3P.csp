BreakStealHouse = 
   let 
      BreakStealHouse0 = [] x : MeansBreakIn @ break.x -> SKIP; Ransack({TV,Money,Laptop}, {})
   within
      BreakStealHouse0; getOutRun -> SKIP

Ransack(s, t) = SKIP
      [] ([] x : Stealable @ x == Other or not member (x, t) and member (x, s) & steal.x -> Ransack(s, union (t, {x})))
      [] not member (Jewels, s) & breakSafe -> Ransack(union (s, {Jewels}), t)