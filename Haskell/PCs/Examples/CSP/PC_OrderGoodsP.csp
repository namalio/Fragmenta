OrderGoods = 
   let 
      CloseOrder = closeOrder -> SKIP
      DoOrder = 
         let 
            DoOrder0 = fillOrder -> Delivery ||| sendInvoice -> receivePayment -> SKIP
            Delivery = regular -> SKIP
                  |~| express -> SKIP
         within
            DoOrder0; CloseOrder
   within
      receiveOrder -> (orderRejected -> CloseOrder
         [] orderAccepted -> DoOrder)