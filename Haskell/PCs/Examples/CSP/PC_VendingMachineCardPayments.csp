datatype DispMsgs = itemCollect | collectTimeout

datatype DispCmds = dispense.OkFail

datatype IMsgs = itemSelect | itemConfirm | cancel

datatype CPCmds = charge | refund

channel frDisp : DispMsgs

channel frI : IMsgs

channel toO : OCmds

channel frPay : CPMsgs

channel a

channel toPay : CPCmds

channel toDisp : DispCmds