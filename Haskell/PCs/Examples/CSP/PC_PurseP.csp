Purse(n) = 
   let 
      TakeMoney = [] a : Int @ a > n & err.InsufficientFunds.a -> Purse(n)
            [] a <= n and a > 0 & takeMoney.a -> Purse(n - a)
            [] a <= 0 & err.InvalidTakeAmount.a -> Purse(n)
      PutMoney = [] a : Int @ if a > 0
         then
            putMoney.a -> Purse(n + a)
         else
            err.InvalidPutAmount.a -> Purse(n)
   within
      if n >= 0
      then
         showBalance.n -> Purse(n)
         [] TakeMoney
         [] PutMoney
      else
         STOP