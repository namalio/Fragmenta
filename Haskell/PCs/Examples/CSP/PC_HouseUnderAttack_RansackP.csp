Ransack = 
   let 
      IntoRoom = 
         let 
            InRoom = roomWindow -> SKIP
                  [] ([] e : {grabLaptop,grabJewels} @ e -> InRoom)
                  [] IntoHall
         within
            intoRoom -> InRoom
      IntoHall = 
         let 
            InLivingRoom = IntoHall
                  [] grabTV -> InLivingRoom
         within
            intoHall -> (mainDoor -> SKIP
               [] intoLivingRoom -> InLivingRoom
               [] intoKitchen -> IntoHall
               [] IntoRoom)
   within
      roomWindow -> IntoRoom
         [] mainDoor -> IntoHall