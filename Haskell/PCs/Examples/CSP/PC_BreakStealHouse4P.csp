BreakStealHouse = 
   let 
      BreakStealHouse0 = DoBurglary[|{alarmSounds}|>SKIP
      DoBurglary = ([] x : MeansBreakIn @ break.x -> SKIP; Steal({Laptop,TV,Other}, {})) ||| alarmSounds -> SKIP
   within
      BreakStealHouse0; getOutAndRun -> SKIP

Steal(s, t) = not member (Jewels, s) & breakSafe -> Steal(union (s, {Jewels}), t)
      [] SKIP
      [] ([] x : Stealable @ x == Other or not member (x, t) and member (x, s) & steal.x -> Steal(s, union ({x}, t)))