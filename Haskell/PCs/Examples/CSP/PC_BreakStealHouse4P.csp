BreakStealHouse = 
   let 
      BreakStealHouse0 = DoBurglary ||| alarmSounds -> SKIP
      DoBurglary = [] x : MeansBreakIn @ break.x -> SKIP; Steal({Laptop,TV,Other}, {})
   within
      BreakStealHouse0; getOutAndRun -> SKIP

Steal(s, t) = Jewels not member s & breakSafe -> Steal(union (s, {Jewels}), t)
      [] SKIP
      [] ([] x : Stealable @ x == Other or x not member t and member (x, s) & steal.x -> Steal(s, union ({x}, t)))