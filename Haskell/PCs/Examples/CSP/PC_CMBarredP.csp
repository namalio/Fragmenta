CMBarred = BarredAsset({cardIn}, {cancel}, {grant}, {optWithdraw,showBalance}, {withdraw,cashDeny,cashDispense,fail,cardSwallow,tock,cardCollect,cardEject,deny,cancel})

BarredAsset(ses, rses, bes, pes, oes) = 
   let 
      BarredAsset0 = (|~| s : ses @ s -> CarryOut)
            |~| (|~| rs : rses @ rs -> SKIP)
      CarryOut = 
         let 
            DoBarred = ((|~| o : oes @ o -> DoBarred)
                  |~| (|~| p : pes @ p -> DoBarred))
                  [] SKIP
         within
            SKIP
               [] ((|~| o : oes @ o -> CarryOut)
               |~| (|~| e : bes @ e -> DoBarred))
   within
      BarredAsset0; BarredAsset(ses, rses, bes, pes, oes)