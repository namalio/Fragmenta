fragment F_AMM {
  SG SG_AMM {
    node Attribute
    nodea Element
    node DiagDef
    virtual Trait
    node Node
    node Connector
    node Definition
    compu DiagDef->Element[contains]:*
    inh Element->Trait
    inh DiagDef->Trait
    inh Attribute->Trait
    inh Connector->Element
    inh Definition->Element
    inh Node->Element
    rel Trait->Trait[has]:*;*
    relu Connector->Node[csrc]
    relu Connector->Node[ctgt]
  }
}
