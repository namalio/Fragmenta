fragment F_MM_12 {
  SG SG_MM_12 {
    node ReferenceC
    proxy PConnector3
    proxy PBindable2
    proxy PReference
    proxy PRefTarget
    proxy PYesNo3
    inh ReferenceC->PConnector3
    inh ReferenceC->PBindable2
    relu ReferenceC->PYesNo3[ReferenceC_hidden]
    derived ReferenceC->PReference[DRCSrc <-> src]:1;1
    derived ReferenceC->PRefTarget[DRCTgt <-> tgt]:*;?
  }
  ref PConnector3->Connector
  ref PBindable2->Bindable
  ref PRefTarget->RefTarget
  ref PReference->Reference
  ref PYesNo3->YesNo
}
