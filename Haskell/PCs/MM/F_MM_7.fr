fragment F_MM_7 {
  SG SG_MM_7 {
     node Quantification
     proxy PNamedNode3
     proxy PAction
     proxy PName2
     proxy POpQuantifiedOp
     proxy POperator
     proxy PGuarded
     proxy PTxtExp
     node TyTxtExp
     virtual Combinable
     inh Quantification->PNamedNode3
     inh Quantification->PGuarded
     inh Quantification->Combinable
     inh Combinable->PAction
     relu Quantification->PName2[var]
     relu Combinable->POperator[op] 
     derived Quantification->POpQuantifiedOp[DQOp <-> op]:*;1
     comp PGuarded->PTxtExp[guard]:?;?
     comp Quantification->TyTxtExp[qtexp]:?;?
  }
  ref PNamedNode3->NamedNode
  ref PAction->Action
  ref PName2->Name
  ref POpQuantifiedOp->OpQuantifiedOp
  ref PGuarded->Guarded
  ref POperator->Operator
  ref PTxtExp->TxtExp
}
