fragment F_MM_8 {
  SG SG_MM_8 {
    proxy PNode
    proxy PAction2
    proxy PCombinable
    proxy PTxtExp2
    node Stop
    node Skip
    node Combination
    virtual Bindable 
    inh Stop->PNode
    inh Skip->PNode
    inh Combination->PNode
    inh Stop->PAction2
    inh Skip->PAction2
    inh Combination->PCombinable
    inh Combination->Bindable 
    comp Bindable->PTxtExp2[arguments]:0..1;*
  }
  ref PNode->Node
  ref PAction2->Action
  ref PCombinable->Combinable
  ref PTxtExp2->TxtExp
}
